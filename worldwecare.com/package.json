    "heroes:fix": "tsx prisma/check-hero-categories.ts --apply",
    "db:seed-digest-email": "tsx prisma/seed-digest-email.ts",
    "digest:dry": "tsx prisma/send-digests.ts --dry-run",
    "digest:send": "tsx prisma/send-digests.ts",
    "follows:recount": "tsx prisma/recount-followers.ts",
    "follows:check": "tsx prisma/recount-followers.ts --dry",
    "i18n:extract": "tsx scripts/extract-strings.ts",
    "i18n:status": "tsx scripts/i18n-status.ts",
    "check:boundary": "tsx scripts/check-client-boundary.ts"
