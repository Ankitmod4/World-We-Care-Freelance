    "counters:check": "tsx prisma/recount-counters.ts",
    "counters:fix": "tsx prisma/recount-counters.ts --apply",
    "reports:check": "tsx prisma/fix-report-duplicates.ts",
    "reports:fix": "tsx prisma/fix-report-duplicates.ts --apply",
    "donations:check": "tsx prisma/diagnose-donations.ts",
    "donations:sweep": "tsx prisma/diagnose-donations.ts --apply",
    "db:seed-payment-emails": "tsx prisma/seed-payment-emails.ts",
