{
  "name": "worldwecare",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-geo": "tsx prisma/seed-geography.ts",
    "db:seed-posts": "tsx prisma/seed-posts.ts",
    "db:seed-chat": "tsx prisma/seed-chat.ts",
    "db:studio": "prisma studio",
    "db:seed-articles": "tsx prisma/seed-articles.ts",
    "db:seed-events": "tsx prisma/seed-events.ts",
    "db:seed-library": "tsx prisma/seed-library.ts",
    "db:backfill-posters": "tsx prisma/backfill-posters.ts",
    "media:refs": "tsx scripts/check-media-refs.ts",
    "media:sweep": "tsx prisma/sweep-media.ts",
    "media:sweep:apply": "tsx prisma/sweep-media.ts --apply",
    "db:seed-campaigns": "tsx prisma/seed-campaigns.ts",
