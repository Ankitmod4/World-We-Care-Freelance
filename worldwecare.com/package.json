    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "and": "^0.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "i": "^0.3.7",
    "leaflet": "^1.9.4",
    "npm": "^11.19.1",
    "postcss": "^8.5.1",
    "prisma": "^6.19.0",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
