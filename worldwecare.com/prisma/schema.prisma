// DONATIONS & PAYOUTS
// ═══════════════════════════════════════════════════════════════
//
// Money is stored as INTEGER MINOR UNITS (cents) everywhere. Never a
// float, never a Decimal-as-string. 0.1 + 0.2 is not 0.3 in binary
// floating point, and money that is one cent wrong is a support ticket
// and, eventually, a reconciliation nightmare.
//
// Currency is a column rather than an assumption even though only USD
// is enabled today — retrofitting currency onto a single-currency
// ledger means rewriting every sum in the system.
//
// Donations are collected into WorldWeCare's own Stripe account and
// earmarked for a recipient, who requests a manual payout. The
// platform fee is taken on the way OUT, at payout time.

enum DonationStatus {
  /// Checkout started, money not confirmed. Never counts toward a balance.
  PENDING
  SUCCEEDED
  /// Refunded in full or in part; see refundedCents.
  REFUNDED
  FAILED
  /// The donor's bank has disputed the charge (a chargeback).
  ///
  /// Stripe removes the money from the platform's balance the moment
  /// a dispute opens, so this status must NEVER count toward anyone's
  /// balance — otherwise a member can withdraw money the platform no
  /// longer holds. `balanceFor` counts only SUCCEEDED and REFUNDED,
  /// which is exactly why moving a row here reverses the credit.
  ///
  /// Winning the dispute moves it back to SUCCEEDED. Losing leaves it
  /// here, which reads correctly: the money is gone.
  DISPUTED
}

model Donation {
  id String @id @default(cuid())

  // ── Stripe identity ──
  // Both unique: the webhook can be delivered more than once, and
  // uniqueness is what makes recording idempotent at the database
  // level rather than relying on the handler getting it right.
  stripeSessionId       String? @unique @db.VarChar(255)
  stripePaymentIntentId String? @unique @db.VarChar(255)
  stripeChargeId        String? @db.VarChar(255)

  // ── the money, in cents ──
  /// What the donor was charged.
  grossCents       Int
  /// Stripe's processing fee, read from the balance transaction — the
  /// REAL number, not 2.9% + 30¢ recomputed here and quietly wrong for
  /// international cards, Amex, or a negotiated rate.
  stripeFeeCents   Int    @default(0)
  /// Taken by the platform at donation time. Usually 0 — the standing
  /// arrangement takes the platform's cut at payout instead — but the
  /// column exists so that policy can change without a migration.
  platformFeeCents Int    @default(0)
  /// What actually credits the recipient's balance.
  netCents         Int
  /// Refunded so far. Subtracted from the recipient's balance.
  refundedCents    Int    @default(0)
  currency         String @default("usd") @db.VarChar(3)

  // ── who gave ──
  /// Null for a signed-out donor. Loose FK: deleting an account must
  /// not delete the financial record of a payment that really happened.
  donorUserId       String?
  donorNameSnapshot String? @db.VarChar(120)
  /// For the receipt. Stripe has it too; kept here so the admin can
  /// answer "who was this from" without opening the dashboard.
  donorEmail        String? @db.VarChar(320)
  isAnonymous       Boolean @default(false)
  /// A note from the donor, shown to the recipient.
  message           String? @db.VarChar(500)

  // ── who it was for ──
  /// The member the donation was earmarked to. Null means it was given
  /// to WorldWeCare itself and credits nobody's balance.
  recipientUserId       String?
  recipientNameSnapshot String? @db.VarChar(120)
  /// Optional campaign the donation was made against.
  campaignId            String?
  /// Optional event the donation was made against. The recipient is
  /// the event's host, so this is about WHY the money was given rather
  /// than who got it.
  eventId               String?
  /// The campaign or event title, frozen. "You gave $25" is a much
  /// worse history line than "You gave $25 to Beach Cleanup", and a
  /// join to fetch it would break the moment the event is deleted.
  causeTitleSnapshot    String? @db.VarChar(200)

  status DonationStatus @default(PENDING)

  /// When this money becomes withdrawable — set to now + the hold
  /// period on success. The hold exists so a refund or chargeback
  /// can't arrive after the recipient has already been paid out,
  /// leaving a balance that cannot go negative but really should.
  availableAt DateTime?

  succeededAt DateTime?
  refundedAt  DateTime?
  failedAt    DateTime?
  /// True when Stripe's real processing fee could not be read at the
  /// time of crediting. The donation is still credited — the money is
  /// real — but with `creditRecipient: "net"` the recipient was given
  /// the full gross and the platform quietly absorbed the fee. The
  /// admin donations list surfaces these so it is a decision rather
  /// than a silent loss.
  feeUnknown  Boolean   @default(false)

  /// When a chargeback was opened. Kept after a won dispute, so the
  /// history of a contested donation survives the status going back
  /// to SUCCEEDED.
  disputedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The balance query: this recipient, succeeded, past its hold.
  @@index([recipientUserId, status, availableAt])
  /// The donor's own history page.
  @@index([donorUserId, createdAt])
  /// Admin listing and campaign totals.
  @@index([status, createdAt])
  /// Dispute events identify a charge, not a payment intent — this is
  /// the first thing that reads stripeChargeId at all.
  @@index([stripeChargeId])
  @@index([campaignId, status])
  @@index([eventId, status])
  @@map("donations")
}

enum PayoutMethodType {
  PAYPAL
  BANK
  WISE
  /// Posted cheque — some members have no account to pay into.
  CHECK
}

/// Where one member wants to be paid.
///
/// `details` is ENCRYPTED (see lib/secret-box.ts). Bank numbers sitting
/// in plaintext in MySQL are the kind of thing that turns a read-only
/// SQL injection into a disclosure incident, and they are of no use to
/// the application except at the moment an admin is sending money.
///
/// `displayHint` is the safe-to-render version — "PayPal · a…@gmail.com",
/// "Bank ····4321" — computed once on save so no read path ever needs
/// to decrypt just to draw a list.
model PayoutMethod {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation("UserPayoutMethods", fields: [userId], references: [id], onDelete: Cascade)
  type   PayoutMethodType

  /// Member's own name for it — "My PayPal", "Joint account".
  label String? @db.VarChar(80)

  /// Sealed JSON. Shape depends on `type`; validated at the API edge.
  details String @db.Text

  /// Never sensitive. Safe to show anywhere.
  displayHint String @db.VarChar(120)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payouts Payout[]

  @@index([userId, isDefault])
  @@map("payout_methods")
}

enum PayoutStatus {
  /// Member asked; the money is reserved against their balance.
  REQUESTED
  /// Admin accepted it but hasn't sent the money yet.
  APPROVED
  /// Money sent. Terminal.
  PAID
  /// Admin declined; the reservation is released. Terminal.
  REJECTED
  /// Member withdrew the request before it was actioned. Terminal.
  CANCELLED
}

/// One withdrawal request.
///
/// Amounts are frozen at request time: the fee percentage in force
/// then is stored on the row, so changing the platform fee later never
/// silently re-prices a request an admin already approved.
model Payout {
  id String @id @default(cuid())

  /// Loose FK, like Donation: a payment record outlives the account.
  userId            String
  userNameSnapshot  String  @db.VarChar(120)
  userEmailSnapshot String? @db.VarChar(320)

  /// Gross taken off the member's balance.
  amountCents    Int
  /// Fee rate applied, in BASIS POINTS — 100 = 1%. An integer, so the
  /// stored rate is exact; a float percentage would reintroduce the
  /// rounding problem this whole schema avoids.
  feeBasisPoints Int
  /// Fee in cents, computed once at request time and stored.
  feeCents       Int
  /// What the member actually receives. amountCents - feeCents.
  netCents       Int
  currency       String @default("usd") @db.VarChar(3)

  /// Nullable so deleting a payout method never deletes payout history.
  methodId       String?
  method         PayoutMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  /// Frozen copy of the method — type, label, displayHint — so a paid
  /// payout still says where the money went after the member has
  /// deleted or changed the account.
  methodSnapshot Json

  status PayoutStatus @default(REQUESTED)

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  paidAt      DateTime?

  reviewedByAdminId String?
  /// Admin-only working note.
  adminNote         String? @db.Text
  /// Shown to the member when declined. Required by the API on reject.
  rejectionReason   String? @db.Text
  /// PayPal transaction id, bank reference, cheque number — whatever
  /// the admin has to point at afterwards.
  externalRef       String? @db.VarChar(160)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The reservation query — everything not yet terminal for this member.
  @@index([userId, status])
  /// The admin queue, oldest request first.
  @@index([status, requestedAt])
  @@map("payouts")
}

// ─────────────────────────────────────────────────────────────────
// TOWN HEROES
//
// The people in a town who quietly do the work — the woman who runs
// the food bank out of her garage, the man who walks other people's
// dogs when they are too unwell to. Members NOMINATE them; an admin
// approves before anything is public.
//
// WHY A MODEL AND NOT AN ARTICLE CATEGORY. The first plan was to make
// this a category of Article, which would have cost nothing. It was
// dropped because a hero is a PERSON, not a piece of writing: the
// tiles have to say "Marie · Cork" the same way every time, the page
// has to be filterable by town, and neither survives being encoded in
// a headline. And an Article is authored by an admin, whereas the
// whole point here is that the community does the finding.
//
// The nominee is not a User and must never be assumed to be one.
// Nobody is asked to sign up to be thanked, and a hero who has never
// heard of the site still belongs on it.
// ─────────────────────────────────────────────────────────────────

enum TownHeroStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What KIND of quiet work this is — the food bank, the dog walks, the
/// homework club. Admin-managed and closed, the same as event and live
/// categories: a taxonomy anyone can extend from a submission form
/// stops being a taxonomy by about the fortieth nomination.
model TownHeroCategory {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(80)
  slug        String  @unique @db.VarChar(80)
  description String? @db.VarChar(300)

  emoji String? @db.VarChar(8)
  /// Hex accent for the tile, e.g. "#f59e0b".
  color String? @db.VarChar(9)

  sortOrder Int     @default(0)
  /// Retire rather than delete: heroes already filed under it keep
  /// their label, and the tile simply stops being offered.
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroes TownHero[]

  @@index([isActive, sortOrder])
  @@map("town_hero_categories")
}

model TownHero {
  id   String @id @default(cuid())
  slug String @unique

  // ── who they are ──
  /// The nominee's name as the nominator wrote it. NOT a User.
  heroName String  @db.VarChar(120)
  /// Free text, deliberately. "Cork", "Blackpool", "the north side"
  /// — a nominator should not have to find their town in a dropdown
  /// before they can say thank you.
  town     String? @db.VarChar(120)
  /// Optional scope so /town-heroes can narrow like events and
  /// petitions do. Loose, like Place and Event — no relation.
  countryId String?

  /// REQUIRED. Every hero is filed under something.
  ///
  /// This started optional, on the reasoning that a nomination should
  /// never fail because somebody could not decide which box it went
  /// in. It is required now by decision, and the cost is paid in the
  /// seed rather than by the nominator: there is an "Anything else"
  /// category, so the picker always has a right answer and nobody is
  /// stuck staring at a form they cannot submit.
  ///
  /// `Restrict`, not `SetNull` — SetNull cannot satisfy a required
  /// column, and Cascade would delete PEOPLE because an admin tidied
  /// up a settings screen. Deleting a category in use is refused at
  /// the database as well as in `deleteHeroCategory`.
  categoryId String
  category   TownHeroCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  photoUrl String?
  photoAlt String? @db.VarChar(300)

  // ── the story ──
  /// One line for the tile: "Runs the Tuesday soup run."
  summary String? @db.VarChar(400)
  /// Why they are a hero. Markdown, same as articles.
  body    String  @db.Text

  // ── who nominated them ──
  // Loose FK plus a snapshot, the house pattern: the nomination has
  // to keep reading correctly after the nominator deletes their
  // account, and it must not become a broken join.
  nominatedByUserId    String?
  nominatorSnapshot    String? @db.VarChar(120)
  /// The nominator can stay out of it. Redacted on the way out, never
  /// at rest — a moderator still has to be able to see who sent it.
  isAnonymous          Boolean @default(false)

  // ── moderation ──
  status          TownHeroStatus @default(PENDING)
  rejectionReason String?        @db.Text
  reviewedAt      DateTime?
  reviewedByAdminId String?
  /// Stamped on the first APPROVED transition and never moved after,
  /// like Article.publishedAt — re-approving an edited hero must not
  /// shove it back to the top of the list.
  approvedAt      DateTime?

  isFeatured Boolean   @default(false)
  featuredAt DateTime?

  heartCount Int             @default(0)
  hearts     TownHeroHeart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The public list, newest approved first.
  @@index([status, approvedAt])
  /// The same list narrowed to a country.
  @@index([countryId, status, approvedAt])
  /// And to a category.
  @@index([categoryId, status, approvedAt])
  /// The admin queue, and "my nominations".
  @@index([nominatedByUserId])
  @@index([isFeatured, featuredAt])
  @@map("town_heroes")
}

model TownHeroHeart {
  heroId    String
  userId    String
  createdAt DateTime @default(now())

  hero TownHero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@id([heroId, userId])
  @@index([userId])
  @@map("town_hero_hearts")
}
