# /etc/systemd/system/mediamtx.service
#
#   systemctl daemon-reload
#   systemctl enable --now mediamtx
#   journalctl -u mediamtx -f
[Unit]
Description=MediaMTX (WorldWeCare live sessions)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mediamtx
Group=mediamtx
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/mediamtx.yml
Restart=always
RestartSec=3

# The config holds the Control API password; the recordings hold
# people's therapy sessions. Neither is world-readable.
UMask=0027
StateDirectory=mediamtx
ReadWritePaths=/var/lib/mediamtx

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
